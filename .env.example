# Copy this file to `.env` and adjust the values for your machine.
# Never commit a real `.env` file — it is git-ignored.
# Actual secrets must only live in environment variables / `.env`, never in source code.

# Long, random string used by Django for cryptographic signing.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Keep True for local development.
DJANGO_DEBUG=True

# Comma-separated list of hosts allowed to serve the app.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database URL. SQLite is the default for local development;
# production PostgreSQL configuration arrives in a later task.
DATABASE_URL=sqlite:///db.sqlite3
